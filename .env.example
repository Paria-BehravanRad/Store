# Shared
NODE_ENV=development

# Database
DATABASE_URL=postgresql://viraplaza:viraplaza@localhost:5433/viraplaza?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Bootstrap admin (phone E.164 or local IR format)
SUPER_ADMIN_PHONE=09120000000

# Melli Payamak (leave empty to use mock SMS in development)
MELLI_PAYAMAK_USERNAME=
MELLI_PAYAMAK_PASSWORD=
MELLI_PAYAMAK_FROM=
SMS_PROVIDER=mock

# SEP payment gateway (leave empty to use mock gateway in development)
SEP_TERMINAL_ID=
SEP_CALLBACK_URL=http://localhost:4000/payments/sep/callback
PAYMENT_GATEWAY=mock

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
